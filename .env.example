# Copy this file to .env and provide local development secrets.
RAG_DASHSCOPE_KEY="your-dashscope-api-key"
JWT_SECRET="replace-with-a-random-secret"
# Optional: exact IP/CIDR of your reverse proxy; leave empty for direct local access.
TRUSTED_PROXIES=
# Optional: number of RabbitMQ consumers that asynchronously persist likes.
LIKE_WORKER_COUNT=4
